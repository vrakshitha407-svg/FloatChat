# FloatChat Environment Configuration
# Copy this file to .env and configure your keys

# Google Gemini API Key (obtain from https://aistudio.google.com/)
# If left empty, FloatChat runs in offline deterministic rule-based mode.
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Maximum request timeout in seconds for Gemini API calls
LLM_TIMEOUT_SECONDS=10.0
